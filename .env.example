# Provenza — hybrid setup (systemd backend + docker infra).
# Copy to .env, or run ./scripts/init-dev-env.sh to generate one.
# Kept private (chmod 600). Back up separately from the database: without
# ALERTMANAGER_SECRET the Alertmanager webhook stops accepting payloads.

# Database (docker compose db service)
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=change_me_in_dot_env
POSTGRES_DB=ai_control_tower

# Redis (docker compose redis service)
REDIS_PASSWORD=change_me_in_dot_env

# Observability
GRAFANA_PASSWORD=change_me_in_dot_env
ALERTMANAGER_SECRET=change_me_in_dot_env

# Frontend / CORS
CORS_ORIGINS=http://localhost:3000
# Passkeys are bound to the host of the first CORS_ORIGINS entry; set this
# only when the site is served under another host name.
# WEBAUTHN_RP_ID=provenza.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
