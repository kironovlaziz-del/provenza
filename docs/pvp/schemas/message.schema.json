    "PVPDelegation": {
      "additionalProperties": false,
      "description": "One agent hands a task, and a subset of its rights, to another. The\nserver checks the subset (child <= parent), the depth and that the\nlifetime never grows down the chain; expires_in counts from the signed\nissued_at, so a late resend cannot extend it.",
      "properties": {
        "chain_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chain Id"
        },
        "delegated_capabilities": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Delegated Capabilities",
          "type": "array"
        },
        "delegated_tools": {
          "anyOf": [
            {
              "items": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 200,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegated Tools"
        },
        "expires_in": {
          "anyOf": [
            {
              "maximum": 2592000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires In"
        },
        "from_agent_id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "From Agent Id",
          "type": "integer"
        },
        "issued_at": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issued At"
        },
        "nonce": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nonce"
        },
        "pq_signature": {
          "anyOf": [
            {
              "maxLength": 6000,
              "minLength": 4,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pq Signature"
        },
        "pvp": {
          "const": "pvp/1",
          "default": "pvp/1",
          "title": "Pvp",
          "type": "string"
        },
        "signature": {
          "anyOf": [
            {
              "maxLength": 6000,
              "minLength": 4,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "task": {
          "maxLength": 10000,
          "title": "Task",
          "type": "string"
        },
        "to_agent_id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "To Agent Id",
          "type": "integer"
        },
        "type": {
          "const": "delegation",
          "default": "delegation",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "from_agent_id",
        "to_agent_id",
        "task"
      ],
      "title": "PVPDelegation",
      "type": "object"
    },
    "PVPError": {
      "additionalProperties": false,
      "description": "A refusal. code is a stable dotted identifier (e.g. agent.key_required);\nmessage is for humans and never echoes the refused content.",
      "properties": {
        "code": {
          "maxLength": 100,
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "title": "Details",
          "type": "object"
        },
        "message": {
          "default": "",
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "pvp": {
          "const": "pvp/1",
          "default": "pvp/1",
          "title": "Pvp",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "PVPError",
      "type": "object"
    },
    "PVPQuery": {
      "additionalProperties": false,
      "description": "A request for evidence. format \"trace\" asks for a TRACE Trust Record\nexport (step P6) instead of the PVP form.",
      "properties": {
        "format": {
          "default": "pvp",
          "enum": [
            "pvp",
            "trace"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "pvp": {
          "const": "pvp/1",
          "default": "pvp/1",
          "title": "Pvp",
          "type": "string"
        },
        "subject": {
          "enum": [
            "receipt",
            "action",
            "chain",
            "checkpoint"
          ],
          "title": "Subject",
          "type": "string"
        },
        "type": {
          "const": "query",
          "default": "query",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "id"
      ],
      "title": "PVPQuery",
      "type": "object"
    },
    "PVPReceipt": {
      "additionalProperties": false,
      "description": "Everything needed to show, without trusting the server, that an\naction was checked, performed as checked, signed by its agent (or\nwitnessed by a Provenza gateway), and committed to the signed audit log:\n\n    action (evidence as recorded) -> seal leaf -> seal record in the\n    audit log (audit_proof, provenza.audit.proof/1) -> signed checkpoint\n\ncurrent_decision is what the action's verdict is now (a human approval\nmay have changed a pending one) - informational, not part of the proof.",
      "properties": {
        "action": {
          "$ref": "#/$defs/PVPAction"
        },
        "audit_proof": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Proof"
        },
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/PVPCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/PVPCheckpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "current_decision": {
          "anyOf": [
            {
              "enum": [
                "allowed",
                "denied",
                "pending_approval"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Decision"
        },
        "pvp": {
          "const": "pvp/1",
          "default": "pvp/1",
          "title": "Pvp",
          "type": "string"
        },
        "seal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PVPSeal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "receipt",
          "default": "receipt",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "PVPReceipt",
      "type": "object"
    },
    "PVPSeal": {
      "additionalProperties": false,
      "description": "Where an action's evidence sits in a seal (app/pvp/seal.py): leaf\nleaf_index of a Merkle tree (RFC 9162) of `size` evidence hashes whose\nroot is written in audit record audit_log_id.",
      "properties": {
        "audit_log_id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Audit Log Id",
          "type": "integer"
        },
        "inclusion_path": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Inclusion Path",
          "type": "array"
        },
        "leaf_index": {
          "minimum": 0,
          "title": "Leaf Index",
          "type": "integer"
        },
        "root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root",
          "type": "string"
        },
        "seal_id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Seal Id",
          "type": "integer"
        },
        "size": {
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "seal_id",
        "leaf_index",
        "size",
        "root",
        "audit_log_id"
      ],
      "title": "PVPSeal",
      "type": "object"
    },
    "PVPSignature": {
      "additionalProperties": false,
      "description": "A signature as evidence: the bytes signed are canonical_bytes of the\nrecord's signed_payload; the keys are the ones that verified it when the\nrecord was made (never \"the agent's current key\"). Hybrid: Ed25519 AND\nML-DSA-65 over the same bytes, both must verify.",
      "properties": {
        "pq_public_key": {
          "anyOf": [
            {
              "maxLength": 6000,
              "minLength": 4,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pq Public Key"
        },
        "pq_signature": {
          "anyOf": [
            {
              "maxLength": 6000,
              "minLength": 4,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pq Signature"
        },
        "public_key": {
          "maxLength": 6000,
          "minLength": 4,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "title": "Public Key",
          "type": "string"
        },
        "scheme": {
          "enum": [
            "ed25519",
            "ed25519+ml-dsa-65"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "signature": {
          "maxLength": 6000,
          "minLength": 4,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "public_key",
        "signature"
      ],
      "title": "PVPSignature",
      "type": "object"
    }
  },
  "$id": "urn:provenza:pvp:1:message.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "action": "#/$defs/PVPAction",
