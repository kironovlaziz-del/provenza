      "action.request": "#/$defs/PVPActionRequest",
      "agent": "#/$defs/PVPAgent",
      "attestation": "#/$defs/PVPAttestation",
      "checkpoint": "#/$defs/PVPCheckpoint",
      "delegation": "#/$defs/PVPDelegation",
      "error": "#/$defs/PVPError",
      "query": "#/$defs/PVPQuery",
      "receipt": "#/$defs/PVPReceipt"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PVPAgent"
    },
    {
      "$ref": "#/$defs/PVPAttestation"
    },
    {
      "$ref": "#/$defs/PVPActionRequest"
    },
    {
      "$ref": "#/$defs/PVPCheck"
    },
    {
      "$ref": "#/$defs/PVPActionRecord"
    },
    {
      "$ref": "#/$defs/PVPAction"
    },
    {
      "$ref": "#/$defs/PVPDelegation"
    },
    {
      "$ref": "#/$defs/PVPCheckpoint"
    },
    {
      "$ref": "#/$defs/PVPReceipt"
    },
    {
      "$ref": "#/$defs/PVPQuery"
    },
    {
      "$ref": "#/$defs/PVPError"
    }
  ],
  "title": "PVP message (pvp/1)"
}
