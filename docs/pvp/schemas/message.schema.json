        },
        "public_key": {
          "maxLength": 6000,
          "minLength": 4,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "title": "Public Key",
          "type": "string"
        },
        "pvp": {
          "const": "pvp/1",
          "default": "pvp/1",
          "title": "Pvp",
          "type": "string"
        },
        "root_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Hash",
          "type": "string"
        },
        "signature": {
          "maxLength": 6000,
          "minLength": 4,
