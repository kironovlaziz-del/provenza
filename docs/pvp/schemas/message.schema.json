          "title": "Pvp",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Required Capabilities",
          "type": "array"
        },
        "tool_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "type": {
          "const": "action.check",
          "default": "action.check",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "tool_name",
        "check_id",
        "input_sha256",
        "decision",
        "expires_at"
      ],
      "title": "PVPCheck",
      "type": "object"
    },
    "PVPCheckpoint": {
