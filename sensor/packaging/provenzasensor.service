[Unit]
Description=Provenza egress sensor
Documentation=https://github.com/kironovlaziz-del/provenza
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/provenza-sensor --config /etc/provenza-sensor/sensor.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# The sensor needs BPF, net admin and its own state. Its programs attach to
# attach_cgroup (default: the cgroup root, so they see every process) and it
# creates run cgroups under /sys/fs/cgroup/provenza-run.
#
# cgroupfs does not support the writable bind-mounts ReadWritePaths sets up,
# so the only workable setting is ProtectControlGroups=false. ProtectSystem
# and ProtectKernelTunables cover everything else in /sys and /usr; the
# cgroup tree is the one writable exception, and even then the sensor only
# creates directories under provenza-run.
AmbientCapabilities=CAP_BPF CAP_CHOWN CAP_SYS_ADMIN CAP_NET_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_CHOWN CAP_SYS_ADMIN CAP_NET_ADMIN
LimitMEMLOCK=infinity
LimitNOFILE=1048576

# Hardening (cgroup tree is exempted above on purpose).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=false
ReadWritePaths=/sys/fs/bpf /var/lib/provenza-sensor /run/provenza-sensor /etc/provenza-sensor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
