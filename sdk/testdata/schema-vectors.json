{
 "about": "JSON Schema checks of HTTP tool arguments: the server (backend/app/pvp/schema_check.py) and the egress proxy (proxy/internal/egress/schema.go) give the same answers. A value \"DEEPn\" stands for {\"x\": ... n levels ... \"leaf\"}.",
 "groups": [
  {
   "name": "nested object, required, no extras",
   "schema": {
    "type": "object",
    "properties": {
     "customer": {
      "type": "object",
      "properties": {
       "id": {
        "type": "integer",
        "minimum": 1
       },
       "email": {
        "type": "string",
        "pattern": "^[^@\\s]+@[^@\\s]+$",
        "maxLength": 254
       }
      },
      "required": [
       "id"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "customer"
    ],
    "additionalProperties": false
   },
   "cases": [
    {
     "value": {
      "customer": {
       "id": 7,
       "email": "a@b.c"
      }
     },
     "valid": true
    },
    {
     "value": {
      "customer": {
       "id": 7
      }
     },
     "valid": true
    },
    {
     "value": {
      "customer": {
       "email": "a@b.c"
      }
     },
     "valid": false
    },
    {
     "value": {
      "customer": {
       "id": 0
      }
     },
     "valid": false
    },
    {
     "value": {
      "customer": {
       "id": 7,
       "extra": 1
      }
     },
     "valid": false
    },
    {
     "value": {
      "customer": {
       "id": 7
      },
      "extra": 1
     },
     "valid": false
    },
    {
     "value": {
      "customer": {
       "id": "7"
      }
     },
     "valid": false
    },
    {
     "value": {
      "customer": {
       "id": 7.0
      }
     },
     "valid": false
    },
    {
     "value": {
      "customer": {
       "id": true
      }
     },
     "valid": false
    },
    {
     "value": {
      "customer": {
       "id": 7,
       "email": "no-at-sign"
      }
     },
     "valid": false
    },
    {
     "value": {
      "customer": {
       "id": 7,
       "email": "a@b.c\n"
      }
     },
     "valid": false
    },
    {
     "value": {},
     "valid": false
    }
   ]
  },
