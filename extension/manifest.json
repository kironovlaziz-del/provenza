{
  "manifest_version": 3,
  "name": "Provenza — AI usage monitor",
  "short_name": "Provenza",
  "version": "2.0.0",
  "description": "Shows your organization which AI services are used, closes the ones it does not allow, and warns before secrets are pasted into an AI tool.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Provenza"
  }
}
