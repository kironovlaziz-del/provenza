# Environment: "development" or "production".
# In production, SECRET_KEY and ENCRYPTION_KEY must be set to real values
# and POSTGRES_PASSWORD / REDIS_PASSWORD must not be defaults.
ENVIRONMENT=development
DEBUG=false

# Frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# With ENVIRONMENT=production the server refuses to start on this
# placeholder (or any key that looks like one).
SECRET_KEY=change-me-generate-a-random-key

# Self-service sign-up (POST /users/register creates a new organization and
# makes the caller its admin). Leave off on a company instance; create the
# first admin with: python scripts/create_admin.py
ALLOW_PUBLIC_SIGNUP=false

# Audit key rotation: distinct admins who must approve a new audit key, and
# how many hours its fingerprint is announced before it can take effect
# (time to publish it outside Provenza). docs/audit-proofs.md
AUDIT_KEY_ROTATION_QUORUM=2
AUDIT_KEY_ROTATION_NOTICE_HOURS=24

# Internal hosts that outbound calls (AI providers, Vault, webhooks) may
# reach, comma-separated hostnames/IPs/CIDRs. Private addresses are refused
# otherwise. Example: OUTBOUND_PRIVATE_ALLOWLIST=vault.corp.local,10.20.0.0/16
OUTBOUND_PRIVATE_ALLOWLIST=
# Egress proxy for those calls, if your network requires one (HTTP(S)_PROXY
# is not used for them). Example: OUTBOUND_PROXY=http://proxy.corp.local:3128
OUTBOUND_PROXY=

# Fernet key for encrypting provider API keys at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_DB=ai_control_tower
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT lifetime
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: SMTP for email notifications. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ai-control-tower@localhost
SMTP_USE_TLS=true
