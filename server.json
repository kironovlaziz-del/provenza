{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kironovlaziz-del/provenza",
  "title": "Provenza",
  "description": "AI governance & security gateway for MCP: approved tools, policy-checked calls, signed audit proofs",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/kironovlaziz-del/provenza/main/docs/brand/provenza-icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/kironovlaziz-del/provenza/main/docs/brand/provenza-icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/kironovlaziz-del/provenza",
    "source": "github",
    "subfolder": "sdk/python"
  },
  "websiteUrl": "https://stickstock.lol",
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "provenza",
      "version": "0.2.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PROVENZA_URL",
          "description": "Your self-hosted Provenza, e.g. https://provenza.example.com",
          "isRequired": true,
          "format": "string"
        },
        {
          "name": "PROVENZA_TOKEN",
          "description": "One-time enrollment token (Agents -> New agent); needed on the first start only",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "PROVENZA_AGENT_NAME",
          "description": "Agent name on this machine (default: mcp)",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
