# Provenza self-hosted configuration. Copy to deploy/.env, or run
# ./scripts/init-env.sh to create it with freshly generated secrets.
# Keep this file private (chmod 600) and back it up separately from the
# database backups: without ENCRYPTION_KEY the encrypted data is unreadable.

# ---- public address -----------------------------------------------------------
# Domain pointing at this server (DNS A/AAAA record). Caddy obtains a TLS
# certificate for it automatically. Use "localhost" for a local trial.
PROVENZA_DOMAIN=provenza.example.com
HTTP_PORT=80
HTTPS_PORT=443

# ---- secrets (required, no defaults) --------------------------------------------
# JWT signing key, at least 32 characters:
#   openssl rand -base64 48 | tr -d '\n'
SECRET_KEY=
# Fernet key that encrypts provider API keys, prompts and connection secrets:
#   openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ---- database -------------------------------------------------------------------
POSTGRES_USER=provenza
POSTGRES_DB=provenza

# ---- application ----------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=info
API_WORKERS=2
CELERY_CONCURRENCY=2
# PII detection by NER (names, organizations, places) in the Prompt Firewall.
PROMPT_FIREWALL_NER_ENABLED=true

# ---- e-mail notifications (optional; leave SMTP_HOST empty to disable) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=provenza@provenza.example.com
SMTP_USE_TLS=true

# ---- resources (container memory limits) -----------------------------------------
POSTGRES_MEMORY=1g
BACKEND_MEMORY=2g
WORKER_MEMORY=2g
FRONTEND_MEMORY=512m
REDIS_MAXMEMORY=256mb

# ---- images ------------------------------------------------------------------------
# Tag used for locally built images; set when pulling prebuilt images.
PROVENZA_IMAGE_PREFIX=provenza
PROVENZA_VERSION=local

# ---- backups (scripts/backup.sh) ------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
