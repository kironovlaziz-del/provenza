# Provenza: Alertmanager (127.0.0.1:9093 only). Rendered by deploy/scripts/units.sh.
[Unit]
Description=Provenza Alertmanager
PartOf=provenza.target
Wants=provenza-backend.service
After=provenza-backend.service

[Container]
ContainerName=alertmanager
Image=docker.io/prom/alertmanager:latest
Network=provenza-data.network
Network=provenza-observability.network
PublishPort=127.0.0.1:9093:9093
Volume=@DEPLOY@/observability/prod/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
Volume=@DEPLOY@/observability/prod/alertmanager-secret:/etc/alertmanager/secret:ro
Volume=provenza-alertmanager-data.volume:/alertmanager
Exec=--config.file=/etc/alertmanager/alertmanager.yml --storage.path=/alertmanager --web.listen-address=0.0.0.0:9093
NoNewPrivileges=true
PodmanArgs=--memory=128m
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=provenza.target
