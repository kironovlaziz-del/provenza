# Provenza: the API (FastAPI). Rendered by deploy/scripts/units.sh.
[Unit]
Description=Provenza API
PartOf=provenza.target
Requires=provenza-migrate.service provenza-redis.service
After=provenza-migrate.service provenza-redis.service

[Container]
ContainerName=backend
Network=provenza-data.network
Network=provenza-web.network
Volume=provenza-app-data.volume:/app/data
Exec=api
# The Observability page reads Prometheus through the API: not 127.0.0.1,
# which is the backend container itself
Environment=PROMETHEUS_URL=http://prometheus:9090
Image=@BACKEND_IMAGE@
EnvironmentFile=@DEPLOY@/.env
Environment=ENVIRONMENT=production
Environment=POSTGRES_HOST=postgres
Environment=POSTGRES_PORT=5432
Environment=REDIS_HOST=redis
Environment=REDIS_PORT=6379
Environment=CORS_ORIGINS=https://@DOMAIN@
ReadOnly=true
Tmpfs=/tmp:size=512m
DropCapability=ALL
NoNewPrivileges=true
LogDriver=journald
PodmanArgs=--memory=@BACKEND_MEMORY@
HealthCmd=python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=40s

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=provenza.target
