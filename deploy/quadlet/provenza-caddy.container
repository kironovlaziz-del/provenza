# Provenza: Caddy, the HTTPS reverse proxy - the only service with public
# ports. Rendered by deploy/scripts/units.sh.
[Unit]
Description=Provenza HTTPS proxy (Caddy)
PartOf=provenza.target
# Wants, not Requires: a broken web UI must not take the API offline too
Wants=provenza-backend.service provenza-frontend.service
After=provenza-backend.service provenza-frontend.service

[Container]
ContainerName=caddy
Image=docker.io/library/caddy:2-alpine
Network=provenza-web.network
PublishPort=@HTTP_PORT@:80
PublishPort=@HTTPS_PORT@:443
PublishPort=@HTTPS_PORT@:443/udp
Environment=PROVENZA_DOMAIN=@DOMAIN@
Volume=@DEPLOY@/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=provenza-caddy-data.volume:/data
Volume=provenza-caddy-config.volume:/config
ReadOnly=true
Tmpfs=/tmp:size=64m
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=provenza.target
